   "source": [
    "import numpy as np\n",
    "X = np.array([\n",
    " [1, 1],\n",
    " [1, 2],\n",
    " [1, 3],\n",
    " [1, 4]\n",
    "])\n",
    "y = np.array([3, 5, 7, 9])\n",
    "Q, R = np.linalg.qr(X)\n",
    "beta = np.linalg.solve(R, Q.T @ y)\n",
    "print(beta)\n"
   ]
  },
