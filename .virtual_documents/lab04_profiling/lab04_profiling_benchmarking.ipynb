import numpy as np


x = np.arange(1000000)



%timeit x ** 2



def square_loop(x):
    result = []

    for value in x:
        result.append(value ** 2)

    return result


%timeit square_loop(x)



def square_numpy(x):
    return x ** 2



%timeit square_numpy(x)








